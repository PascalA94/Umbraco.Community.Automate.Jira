<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework Condition="'$(AutomateMajor)' != '19'">net10.0</TargetFramework>
    <TargetFramework Condition="'$(AutomateMajor)' == '19'">net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <!-- Spike-only: one project, built against the 18 or the 19 Automate line (site17 uses Spike17). -->
    <AutomateMajor Condition="'$(AutomateMajor)' == ''">18</AutomateMajor>
    <RootNamespace>Umbraco.Community.Automate.Jira</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup Condition="'$(AutomateMajor)' == '19'">
    <PackageReference Include="Umbraco.Automate" Version="19.0.0-rc1" />
  </ItemGroup>
  <ItemGroup Condition="'$(AutomateMajor)' == '18'">
    <PackageReference Include="Umbraco.Automate" Version="18.5.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(AutomateMajor)' == '17'">
    <PackageReference Include="Umbraco.Automate" Version="17.5.1" />
  </ItemGroup>
</Project>
