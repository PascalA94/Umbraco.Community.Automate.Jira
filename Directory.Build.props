<Project>
  <!--
    One codebase, three Umbraco Automate lines. -p:AutomateMajor=17|18|19 picks the dependency set,
    the closed version ranges, the package version and the AUTOMATE_17 / AUTOMATE_18 / AUTOMATE_19 constant.
    Lines 17 and 18 target net10.0; line 19 targets net11.0 (Umbraco 19 does not restore on net10.0, NU1202).
  -->
  <PropertyGroup>
    <AutomateMajor Condition="'$(AutomateMajor)' == ''">18</AutomateMajor>
    <TargetFramework Condition="'$(AutomateMajor)' != '19'">net10.0</TargetFramework>
    <TargetFramework Condition="'$(AutomateMajor)' == '19'">net11.0</TargetFramework>
    <AutomateFloat Condition="'$(AutomateFloat)' == ''">false</AutomateFloat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AutomateMajor)' == '18'">
    <AutomateVersion>18.5.1</AutomateVersion>
    <AutomateRange>[18.5.1, 19.0.0)</AutomateRange>
    <!-- 18.3.2, not 18.3.0: GHSA-348f-9mg8-rhv4 (member property values in the members index) is fixed in 18.3.2. -->
    <UmbracoCmsVersion>18.3.2</UmbracoCmsVersion>
    <UmbracoCmsRange>[18.3.2, 19.0.0)</UmbracoCmsRange>
    <!-- CMS 18.3.2 is built against Markdig 1.4.0; 1.5.1 is HQ's pin (plan Global Constraints). -->
    <MarkdigRange>[1.5.1, 2.0.0)</MarkdigRange>
    <IntegrationTestSdkVersion>18.10.1</IntegrationTestSdkVersion>
    <IntegrationMessagePackVersion>3.1.11</IntegrationMessagePackVersion>
  </PropertyGroup>
  <!-- Release candidate line: Umbraco names its prerelease 19.0.0-rc1. Move the floors to 19.0.0 at stable. -->
  <PropertyGroup Condition="'$(AutomateMajor)' == '19'">
    <AutomateVersion>19.0.0-rc1</AutomateVersion>
    <AutomateRange>[19.0.0-rc1, 20.0.0)</AutomateRange>
    <UmbracoCmsVersion>19.0.0-rc1</UmbracoCmsVersion>
    <UmbracoCmsRange>[19.0.0-rc1, 20.0.0)</UmbracoCmsRange>
    <!-- CMS 19.0.0-rc1 depends on Markdig 1.5.1, the same as 18. -->
    <MarkdigRange>[1.5.1, 2.0.0)</MarkdigRange>
    <!-- Umbraco.Cms.Tests.Integration 19.0.0-rc1 needs Test.Sdk 18.11.0 or later (NU1605) and MessagePack 3.1.12. -->
    <IntegrationTestSdkVersion>18.11.0</IntegrationTestSdkVersion>
    <IntegrationMessagePackVersion>3.1.12</IntegrationMessagePackVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AutomateMajor)' == '17'">
    <AutomateVersion>17.5.1</AutomateVersion>
    <AutomateRange>[17.5.1, 18.0.0)</AutomateRange>
    <!-- 17.8.2, not 17.8.0: GHSA-348f-9mg8-rhv4 (member property values in the members index) is fixed in 17.8.2. -->
    <UmbracoCmsVersion>17.8.2</UmbracoCmsVersion>
    <UmbracoCmsRange>[17.8.2, 18.0.0)</UmbracoCmsRange>
    <!-- CMS 17.8.2 is built against Markdig 0.45.0. Forcing 1.x onto a v17 site would swap a major
         version under the CMS's own Markdown rendering, so the 17 line stays on the CMS's 0.x line. -->
    <MarkdigRange>[0.45.0, 1.0.0)</MarkdigRange>
    <IntegrationTestSdkVersion>18.10.1</IntegrationTestSdkVersion>
    <IntegrationMessagePackVersion>3.1.11</IntegrationMessagePackVersion>
  </PropertyGroup>

  <!-- Fails fast: an unknown line would otherwise restore with empty version ranges. -->
  <Target Name="ValidateAutomateMajor" BeforeTargets="CollectPackageReferences;_GenerateRestoreGraph" Condition="'$(AutomateMajor)' != '17' and '$(AutomateMajor)' != '18' and '$(AutomateMajor)' != '19'">
    <Error Text="AutomateMajor must be 17, 18 or 19 (was '$(AutomateMajor)')." />
  </Target>

  <!-- Latest leg of CI: floating $(AutomateMajor).* so a new Automate release is exercised without a PR. Never packed. -->
  <PropertyGroup>
    <AutomateVersionSpec>$(AutomateRange)</AutomateVersionSpec>
    <UmbracoCmsVersionSpec>$(UmbracoCmsRange)</UmbracoCmsVersionSpec>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AutomateFloat)' == 'true'">
    <AutomateVersionSpec>$(AutomateMajor).*</AutomateVersionSpec>
    <UmbracoCmsVersionSpec>$(AutomateMajor).*</UmbracoCmsVersionSpec>
  </PropertyGroup>
  <!-- 19.* matches no prerelease (NU1102 while only 19.0.0-rc1 exists), so the 19 line floats 19.*-*. Remove at 19.0.0 stable. -->
  <PropertyGroup Condition="'$(AutomateFloat)' == 'true' and '$(AutomateMajor)' == '19'">
    <AutomateVersionSpec>$(AutomateMajor).*-*</AutomateVersionSpec>
    <UmbracoCmsVersionSpec>$(AutomateMajor).*-*</UmbracoCmsVersionSpec>
  </PropertyGroup>

  <!-- Version: <line>.<minor>.<patch>; pre-releases pass -p:VersionSuffix=beta.1 -->
  <PropertyGroup>
    <PackageMinor Condition="'$(PackageMinor)' == ''">0</PackageMinor>
    <PackagePatch Condition="'$(PackagePatch)' == ''">0</PackagePatch>
    <VersionPrefix>$(AutomateMajor).$(PackageMinor).$(PackagePatch)</VersionPrefix>
    <DefineConstants>$(DefineConstants);AUTOMATE_$(AutomateMajor)</DefineConstants>
  </PropertyGroup>

  <!--
    One lock file per line, because a single file cannot hold two Automate versions.
    A floating restore cannot be locked, so it gets a separate, git-ignored path and never touches the committed files.
  -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath>packages.$(AutomateMajor).lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AutomateFloat)' == 'true'">
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <NuGetLockFilePath>packages.$(AutomateMajor).float.lock.json</NuGetLockFilePath>
  </PropertyGroup>

  <PropertyGroup>
    <Company>Pascal Meyer</Company>
    <Authors>Pascal Meyer</Authors>
    <Copyright>Copyright (c) Pascal Meyer $([System.DateTime]::Today.ToString('yyyy'))</Copyright>
    <Product>Umbraco Automate connector for Jira</Product>
    <PackageProjectUrl>https://github.com/PascalA94/Umbraco.Community.Automate.Jira</PackageProjectUrl>
    <RepositoryUrl>https://github.com/PascalA94/Umbraco.Community.Automate.Jira</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>logo-128.png</PackageIcon>
    <PackageTags>umbraco umbraco-marketplace umbracopackage umbraco-automate automate jira atlassian</PackageTags>
    <!-- The Marketplace does not list prerelease-only packages, so the 19 release candidate carries no Marketplace tag. Restore it at 19.0.0 stable. -->
    <PackageTags Condition="'$(AutomateMajor)' == '19'">$(PackageTags.Replace('umbraco-marketplace ', ''))</PackageTags>
    <NeutralLanguage>en-GB</NeutralLanguage>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
  </PropertyGroup>

  <!-- SourceLink, symbols package, deterministic build -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
</Project>
