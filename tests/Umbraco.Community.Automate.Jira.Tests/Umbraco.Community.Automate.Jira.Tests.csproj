<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>Umbraco.Community.Automate.Jira.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Meziantou.Framework.AtlassianDataFormat" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Umbraco.Automate.Testing" />
    <!-- Credential isolation suite only (contract section 5.2, I06 and I07): Automate's real registration entry
         point lives in Startup, and the configuration-consumer scan must see every assembly a site loads. -->
    <PackageReference Include="Umbraco.Automate.Persistence" />
    <PackageReference Include="Umbraco.Automate.Startup" />
    <PackageReference Include="Umbraco.Automate.Web" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Umbraco.Community.Automate.Jira\Umbraco.Community.Automate.Jira.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Contract section 4 item 6: conformance tests C17 and C18 hash and version-check the store and both verbatim suites. -->
    <EmbeddedResource Include="..\..\src\Umbraco.Community.Automate.Jira\CredentialHelper\JiraCredentialStore.cs" LogicalName="CredentialHelperContract.StoreSource.cs" />
    <EmbeddedResource Include="CredentialHelperContract\CredentialHelperStoreContractTests.cs" LogicalName="CredentialHelperContract.StoreContractTests.cs" />
    <EmbeddedResource Include="CredentialHelperContract\CredentialIsolationContractTests.cs" LogicalName="CredentialHelperContract.IsolationContractTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fixtures are read from the output folder so tests never depend on the working directory. -->
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- The demo's use case 4 seed, read by UseCase4SeedTests (the automated F-01 guard). -->
    <None Include="..\..\demo\Umbraco.Community.Automate.Jira.TestSite\Seeds\usecase4.automation.json" Link="Seeds\usecase4.automation.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
